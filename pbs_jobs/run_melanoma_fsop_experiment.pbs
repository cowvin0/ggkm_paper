#!/bin/bash

#PBS -N melanoma_fosp

# 4 kernel models × 8 kernels
# + 2 parametric models
# = 34 tasks
#PBS -J 0-33

#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=336:00:00


cd "$PBS_O_WORKDIR" || exit 1

mkdir -p logs


exec > "logs/melanoma_fosp_${PBS_JOBID}_${PBS_ARRAY_INDEX}.out"
exec 2> "logs/melanoma_fosp_${PBS_JOBID}_${PBS_ARRAY_INDEX}.err"


echo "=================================="
echo "Job ID: $PBS_JOBID"
echo "Task ID: $PBS_ARRAY_INDEX"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "Working directory: $(pwd)"
echo "=================================="


TASK_START=$(date +%s)


module purge

module load gcc/14.2.0
module load python/3.12.8
module load pcre2/10.44


export R_HOME="$HOME/master_thesis/ggkm/utils/R-4.4.3"
export LD_LIBRARY_PATH="$R_HOME/lib:${LD_LIBRARY_PATH:-}"


source "$HOME/venvs/master_thesis/bin/activate"


# ------------------------------------------------------------
# Parallelism
# ------------------------------------------------------------

# The PBS allocation requests 4 CPUs, but start conservatively
# with 2 simultaneous outer CV splits.
export GGKM_OUTER_WORKERS=2

# Prevent each worker from spawning additional BLAS/OpenMP threads.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


echo
echo "Python:"
which python
python --version

echo
echo "Resources:"
echo "PBS_NCPUS=${PBS_NCPUS:-not_set}"
echo "GGKM_OUTER_WORKERS=$GGKM_OUTER_WORKERS"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "OPENBLAS_NUM_THREADS=$OPENBLAS_NUM_THREADS"
echo "MKL_NUM_THREADS=$MKL_NUM_THREADS"
echo "NUMEXPR_NUM_THREADS=$NUMEXPR_NUM_THREADS"
echo "Memory requested: 64 GB"

echo
echo "Kernel implementation:"
python - <<'PY'
import inspect
from sklearn.metrics.pairwise import rbf_kernel
import skcure.utils.kernels as kernels

print("Kernel file:", kernels.__file__)

print()
print("RBF implementation:")
print(inspect.getsource(rbf_kernel))

print()
print("Wavelet implementation:")
print(inspect.getsource(kernels.wavelet_kernel))
PY

echo
echo "FOSP melanoma preprocessing:"
python - <<'PY'
import inspect
import skcure.utils.preprocessing as preprocessing

print("Preprocessing file:", preprocessing.__file__)
print()
print("Preprocessor:")
print(preprocessing.FOSPMelanomaSurvivalPreprocessor)
PY

echo
echo "Starting FOSP melanoma experiment..."
echo


python -u -m ggkm_paper.scripts.run_melanoma_fosp_experiment

EXIT_STATUS=$?


TASK_END=$(date +%s)

ELAPSED=$((TASK_END - TASK_START))


echo
echo "=================================="
echo "Finished: $(date)"
echo "Exit status: $EXIT_STATUS"
echo "Elapsed seconds: $ELAPSED"
echo "Elapsed minutes: $(awk "BEGIN {printf \"%.2f\", $ELAPSED/60}")"
echo "Elapsed hours: $(awk "BEGIN {printf \"%.2f\", $ELAPSED/3600}")"
echo "=================================="


exit "$EXIT_STATUS"
