#!/bin/bash

#PBS -N melanoma_models

# 4 kernel models × 7 kernels
# + 2 parametric baseline models
# + 2 spline models
# = 32 tasks
#PBS -J 0-31

# Four outer holdouts are processed concurrently.
# Each worker uses one CPU and Optuna itself remains serial.
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=72:00:00


cd "$PBS_O_WORKDIR" || exit 1


mkdir -p logs


exec > "logs/melanoma_${PBS_JOBID}_${PBS_ARRAY_INDEX}.out"
exec 2> "logs/melanoma_${PBS_JOBID}_${PBS_ARRAY_INDEX}.err"


echo "=================================="
echo "Job ID: $PBS_JOBID"
echo "Task ID: $PBS_ARRAY_INDEX"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "Working directory: $PBS_O_WORKDIR"
echo "=================================="


TASK_START=$(date +%s)


module purge

module load gcc/14.2.0
module load python/3.12.8
module load pcre2/10.44


export R_HOME="$HOME/master_thesis/ggkm/utils/R-4.4.3"

export LD_LIBRARY_PATH="$R_HOME/lib:$LD_LIBRARY_PATH"


source ~/venvs/master_thesis/bin/activate


#
# One BLAS/OpenMP thread per Python worker.
#
# We parallelize across outer repeated holdouts instead.
#
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


export PYTHONHASHSEED=0


echo ""
echo "Python:"
which python
python --version

echo ""
echo "PBS resources:"
echo "NCPUS: ${PBS_NCPUS:-unknown}"

echo ""
echo "Starting melanoma experiment..."
echo ""


python -u -m ggkm_paper.scripts.run_melanoma_experiment

EXIT_STATUS=$?


TASK_END=$(date +%s)

ELAPSED=$((TASK_END - TASK_START))


echo ""
echo "=================================="
echo "Finished: $(date)"
echo "Exit status: $EXIT_STATUS"
echo "Elapsed seconds: $ELAPSED"
echo "Elapsed minutes: $(awk "BEGIN {printf \"%.2f\", $ELAPSED/60}")"
echo "Elapsed hours: $(awk "BEGIN {printf \"%.2f\", $ELAPSED/3600}")"
echo "=================================="


exit $EXIT_STATUS
