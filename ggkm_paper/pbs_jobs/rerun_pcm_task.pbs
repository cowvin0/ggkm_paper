#!/bin/bash

#PBS -N pcm_rerun
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=336:00:00

cd "$PBS_O_WORKDIR" || exit 1

# ------------------------------------------------------------
# TASK_ID is supplied with:
#
# qsub -v TASK_ID=218 rerun_pcm_task.pbs
# ------------------------------------------------------------

if [ -z "$TASK_ID" ]; then
    echo "ERROR: TASK_ID was not supplied."
    echo "Example:"
    echo "qsub -v TASK_ID=218 rerun_pcm_task.pbs"
    exit 1
fi

# Your Python program expects PBS_ARRAY_INDEX.
# We manually give it the original task index.
export PBS_ARRAY_INDEX="$TASK_ID"

mkdir -p logs

exec > "logs/pcm_rerun_${PBS_JOBID}_task${TASK_ID}.out"
exec 2> "logs/pcm_rerun_${PBS_JOBID}_task${TASK_ID}.err"

echo "=================================="
echo "Job ID: $PBS_JOBID"
echo "Original task ID: $TASK_ID"
echo "PBS_ARRAY_INDEX: $PBS_ARRAY_INDEX"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "=================================="

TASK_START=$(date +%s)

module purge

module load gcc/14.2.0
module load python/3.12.8
module load pcre2/10.44

export R_HOME=$HOME/master_thesis/ggkm/utils/R-4.4.3
export LD_LIBRARY_PATH=$R_HOME/lib:$LD_LIBRARY_PATH

source ~/venvs/master_thesis/bin/activate

echo ""
echo "Python:"
which python
python --version

echo ""
echo "Starting Monte Carlo simulation..."
echo "Original task index: $PBS_ARRAY_INDEX"
echo ""

python -u -m ggkm_paper.scripts.run_pcm_experiment

EXIT_STATUS=$?

TASK_END=$(date +%s)
ELAPSED=$((TASK_END - TASK_START))

echo ""
echo "=================================="
echo "Finished: $(date)"
echo "Original task ID: $TASK_ID"
echo "Exit status: $EXIT_STATUS"
echo "Elapsed seconds: $ELAPSED"
echo "Elapsed minutes: $(awk "BEGIN {printf \"%.2f\", $ELAPSED/60}")"
echo "=================================="

exit $EXIT_STATUS
