\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Predictive assessment in 50 paired repeated holdouts of the breast cancer cohort. Panel A compares the full-cohort Kaplan--Meier curve with split-averaged out-of-sample survival predictions over the common supported horizon. Panel B shows split-level IPCW integrated Brier scores and Panel C shows the corresponding cure-discrimination area under the curve ($\mathrm  {AUC}_{\mathrm  {cure}}$). Each point represents one outer split, and lower IBS values indicate better prediction whereas larger cure AUC values indicate better discrimination.}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:breast-cancer-performance}{{8}{18}{Predictive assessment in 50 paired repeated holdouts of the breast cancer cohort. Panel A compares the full-cohort Kaplan--Meier curve with split-averaged out-of-sample survival predictions over the common supported horizon. Panel B shows split-level IPCW integrated Brier scores and Panel C shows the corresponding cure-discrimination area under the curve ($\mathrm {AUC}_{\mathrm {cure}}$). Each point represents one outer split, and lower IBS values indicate better prediction whereas larger cure AUC values indicate better discrimination}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Kernel-specific predictive performance of the GG-KM models in 50 paired repeated holdouts of the breast cancer cohort. Panel A shows the split-level IPCW integrated Brier score and Panel B the cure-discrimination area under the curve ($\mathrm  {AUC}_{\mathrm  {cure}}$) across the seven candidate kernels. Within each kernel, Poisson and negative-binomial GG-KM results are shown side by side, with color and hatching distinguishing the two latent-count laws. Individual points represent outer splits and boxplots summarize their distributions.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:breast-cancer-performance-ggkm-kernel}{{9}{18}{Kernel-specific predictive performance of the GG-KM models in 50 paired repeated holdouts of the breast cancer cohort. Panel A shows the split-level IPCW integrated Brier score and Panel B the cure-discrimination area under the curve ($\mathrm {AUC}_{\mathrm {cure}}$) across the seven candidate kernels. Within each kernel, Poisson and negative-binomial GG-KM results are shown side by side, with color and hatching distinguishing the two latent-count laws. Individual points represent outer splits and boxplots summarize their distributions}{figure.caption.14}{}}
